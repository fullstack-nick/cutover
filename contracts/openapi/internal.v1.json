{
  "openapi": "3.1.2",
  "info": {
    "title": "Cutover internal operations",
    "version": "1.0.0",
    "description": "Local authenticated service and test interfaces. The console proxy rejects /internal. An explicitly started core-api or adapter-api loopback forward permits verification with a separately authorized JWT. Process controls affect the single active lab site and require both the test-control role and scenario-driver client. They are absent when cutover.test-controls-enabled is false."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8784",
      "description": "Explicit core-api forward"
    },
    {
      "url": "http://127.0.0.1:8785",
      "description": "Explicit adapter-api forward"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/internal/v1/sites/{site}/test-controls": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site"
        }
      ],
      "get": {
        "operationId": "readProcessControls",
        "responses": {
          "200": {
            "description": "Current version and pause/critical-storage flags"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      },
      "post": {
        "operationId": "changeProcessControls",
        "parameters": [
          {
            "$ref": "#/components/parameters/key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/runtime-control-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned, audited control change recorded"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/test-controls/faults": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site"
        }
      ],
      "get": {
        "operationId": "readProcessFaults",
        "responses": {
          "200": {
            "description": "Most recent 100 retained one-shot activations, including fired event IDs"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      },
      "post": {
        "operationId": "armProcessFault",
        "description": "expectedVersion is the process-control version. A new one-shot fault has its own version 1. An explicit eventId can select an existing event; otherwise only matching events committed after arming are eligible. Consumption and audit commit before fixed exit code 73. At most one armed fault per site/checkpoint.",
        "parameters": [
          {
            "$ref": "#/components/parameters/key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/process-fault-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One-shot fault armed; returns faultId, version and controlVersion"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/test-controls/faults/{id}/clear": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site"
        },
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "post": {
        "operationId": "clearProcessFault",
        "description": "expectedVersion is the fault version. Activation history is retained.",
        "parameters": [
          {
            "$ref": "#/components/parameters/key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/reconciliation-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fault disabled without deleting its evidence"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/messaging": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site"
        }
      ],
      "get": {
        "operationId": "readDeliveryBacklog",
        "responses": {
          "200": {
            "description": "Site-scoped counters and up to 100 outstanding inbox/outbox entries"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/messaging/{kind}/{id}/replay": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site"
        },
        {
          "$ref": "#/components/parameters/id"
        },
        {
          "name": "kind",
          "in": "path",
          "required": true,
          "schema": {
            "enum": [
              "inbox",
              "outbox"
            ]
          }
        }
      ],
      "post": {
        "operationId": "recordDeliveryReplay",
        "description": "Supervisor only. Retains original envelope and event ID; cannot retry an applied inbox row or bypass an active publish lease. Outbox replay reserves unpublished capacity again.",
        "parameters": [
          {
            "$ref": "#/components/parameters/key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/reconciliation-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Audited retry recorded"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/cancellations": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site"
        }
      ],
      "post": {
        "operationId": "fenceOrderCancellation",
        "description": "Adapter endpoint for the legacy-core identity only. Atomically checks every immutable outbound movement against its durable journal and fences all allocations. Unknown/submitted work rejects the entire request. Identical requests return the stored certificate. No network call occurs while route locks are held.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/cancellation-fence-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retained complete fence certificate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/cancellation-certificate.v1.json"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/platform/storage": {
      "get": {
        "operationId": "readOwnerStorage",
        "description": "Platform-administrator diagnostic. Own database bytes, retained/unpublished message quotas and seven-day replay horizon. No business recovery authority.",
        "responses": {
          "200": {
            "description": "Bounded current diagnostic view"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/platform/untrusted-deliveries": {
      "get": {
        "operationId": "readUntrustedDeliveryDiagnostics",
        "description": "Platform-administrator diagnostic. Up to 100 site-less entries with opaque IDs, hash, size, reason and time; no raw payload, publisher or claimed business identity.",
        "responses": {
          "200": {
            "description": "Bounded current diagnostic view"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/messaging/quarantine": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site"
        }
      ],
      "get": {
        "operationId": "readSiteRawQuarantine",
        "description": "Operator/supervisor site-scoped view of original deliveries that failed before inbox transfer.",
        "responses": {
          "200": {
            "description": "Bounded current diagnostic view"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/messaging/quarantine/{id}/reprocess": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site"
        },
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "post": {
        "operationId": "reprocessOriginalDelivery",
        "description": "Supervisor action. Requires an authorized site, current raw-delivery version, correction reason and idempotency key. Original bytes/exchange/transport identity are immutable and pass through current validation. TRANSFERRED means the durable inbox owns the result; it does not promise a business effect.",
        "parameters": [
          {
            "$ref": "#/components/parameters/key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/reconciliation-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Audited versioned result: deliveryId, state QUARANTINED or TRANSFERRED, version"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/zones/{zone}/scheduling-context": {
      "parameters": [
        {
          "name": "site",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "zone",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "readSchedulingContext",
        "description": "Read-only service query. Returns route, site-filtered equipment, allocations and known commands for at most 64 unique movement IDs while sharing the authoritative route lock. Intake independently rechecks every dispatch.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "movementIds": {
                    "type": "array",
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                },
                "required": [
                  "movementIds"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded authoritative observations"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/test-controls/scheduling-rounds": {
      "parameters": [
        {
          "name": "site",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "recordSeededSchedulingRound",
        "description": "Explicitly enabled scenario-driver/test-control interface. Runs the actual legacy SQL, persists the synthetic input and publishes only to the separate observation queue. Never creates a task or equipment command.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/scheduling-snapshot.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted round identity and input hash"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/legacy-registrations": {
      "parameters": [
        {
          "name": "site",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          }
        }
      ],
      "post": {
        "operationId": "registerOriginalLegacyInventory",
        "description": "Initial owner maintenance only. The legacy-core client supplies up to 32 settled original tasks while adapter dispatch is paused at the expected control version. Retained allocations, physical completion or cancellation states must agree. This creates registration receipts without changing ownership or creating physical work.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/baseline-registration-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete batch of retained allocation receipts and gate version"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/zones/{zone}/migration-evidence": {
      "parameters": [
        {
          "name": "site",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "zone",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "readOwnerMigrationEvidence",
        "description": "Read-only core/execution API restricted to the authenticated equipment-adapter service. At most 64 unique movement IDs; an empty core request checks that the guarded assignment boundary is installed. Missing and wrong-zone movements are explicit. Each owner reads only its own database.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/migration-evidence-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded owner proof and assignment-boundary capability"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/test-controls/migration-faults": {
      "parameters": [
        {
          "name": "site",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "listMigrationProcessFaults",
        "responses": {
          "200": {
            "description": "Latest 100 one-shot process faults"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      },
      "post": {
        "operationId": "armMigrationProcessFault",
        "description": "Explicitly enabled scenario-driver/test-control only. Expected adapter control version. Saves a one-shot fault before an actual process halt with exit 73 after the selected durable phase commits. A selected existing session or a session created after arming can consume it. Consumption is committed before halt; restart cannot repeat it.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/migration-process-fault-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded fault identity and version"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/test-controls/migration-faults/{id}/clear": {
      "parameters": [
        {
          "name": "site",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "clearMigrationProcessFault",
        "description": "Explicit scenario-driver/test-control clears an armed fault with expected fault version and an audited reason.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/reconciliation-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cleared fault record"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/messaging/shadow-observations": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site"
        }
      ],
      "get": {
        "operationId": "readShadowObservationBacklog",
        "description": "Legacy core only. Site-scoped operator, supervisor, platform administrator or service read. Returns up to 100 retained pending observations.",
        "responses": {
          "200": {
            "description": "Retained optional observation transport evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/shadow-backlog.v1.json"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/internal/v1/sites/{site}/messaging/shadow-observations/{id}/replay": {
      "parameters": [
        {
          "$ref": "#/components/parameters/site"
        },
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "post": {
        "operationId": "recordShadowObservationReplay",
        "description": "Legacy core only, supervisor required. Reopens only a paused unpublished observation without an active lease. Expected version fences explicit recovery actions. Original event ID, bytes and pending quota are preserved; this action grants no business task or physical command authority.",
        "parameters": [
          {
            "$ref": "#/components/parameters/key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/reconciliation-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Audited original observation retry recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "eventId",
                    "state",
                    "version"
                  ],
                  "properties": {
                    "eventId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "state": {
                      "const": "RETRY_RECORDED"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "site": {
        "name": "site",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 40
        }
      },
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "key": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "responses": {
      "problem": {
        "description": "400 malformed; 401 invalid authentication; 403 role/client denied; 404 absent, outside site or disabled; 409 version/state/key conflict; 413 oversize; 422 contract; 503 unavailable durability (Retry-After)."
      }
    }
  }
}
