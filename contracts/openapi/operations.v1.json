      "post": {
        "operationId": "startMigration",
        "description": "Supervisor starts drain with an expected route version and reason. New intents remain unassigned; all allocated work and physical evidence must reconcile before an atomic epoch change. A reversal is another complete drain.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/migration-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably recorded session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/migration-view"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/api/v1/sites/{siteId}/migrations/{id}/recovery": {
      "parameters": [
        {
          "name": "siteId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "recoverMigration",
        "description": "Supervisor resumes the same session after six exhausted owner-evidence transport attempts. Expected session version and reason are required. No physical identity or proof is replaced.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/reconciliation-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durably recorded session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/migration-view"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/api/v1/sites/{siteId}/migrations/{id}/cancellation": {
      "parameters": [
        {
          "name": "siteId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "cancelMigration",
        "description": "Supervisor cancels only an unswitched session with the expected session version and reason. Existing owner/epoch remain; pending unassigned work is released. After switching, use a new reverse migration.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/reconciliation-request.v1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durably recorded session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/migration-view"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "equipment-command": {
        "$ref": "../schemas/equipment-command.v1.json"
      },
      "event-envelope": {
        "$ref": "../schemas/event-envelope.v1.json"
      },
      "migration-request": {
        "$ref": "../schemas/migration-request.v1.json"
      },
      "movement": {
        "$ref": "../schemas/movement.v1.json"
      },
      "order-request": {
        "$ref": "../schemas/order-request.v1.json"
      },
      "receipt-request": {
        "$ref": "../schemas/receipt-request.v1.json"
      },
      "reconciliation-request": {
        "$ref": "../schemas/reconciliation-request.v1.json"
      },
      "problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "accepted": {
        "type": "object",
        "required": [
          "id",
          "statusUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "statusUrl": {
            "type": "string"
          }
        }
      },
      "order-view": {
        "$ref": "../schemas/order-view.v1.json"
      },
      "order-page": {
        "$ref": "../schemas/order-page.v1.json"
      },
      "task-list": {
        "$ref": "../schemas/task-list.v1.json"
      },
      "equipment-view": {
        "$ref": "../schemas/equipment-view.v1.json"
      },
      "command-view": {
        "$ref": "../schemas/command-view.v1.json"
      },
      "cancellation-certificate": {
        "$ref": "../schemas/cancellation-certificate.v1.json"
      },
      "scheduling-comparison": {
        "type": "object",
        "properties": {
          "roundId": {
            "type": "string",
            "format": "uuid"
          },
          "inputHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "input": {
            "type": "object",
            "properties": {
              "ruleVersion": {
                "const": 1
              },
              "siteId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$"
              },
              "zoneId": {
                "enum": [
                  "ambient",
                  "chilled"
                ]
              },
              "decisionAt": {
                "type": "string",
                "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
                "format": "date-time"
              },
              "observedAt": {
                "type": "string",
                "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
                "format": "date-time"
              },
              "topologyVersion": {
                "type": "integer",
                "minimum": 0
              },
              "worldMismatch": {
                "type": "boolean"
              },
              "route": {
                "type": "object",
                "properties": {
                  "owner": {
                    "enum": [
                      "legacy-core",
                      "execution-service"
                    ]
                  },
                  "epoch": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "state": {
                    "enum": [
                      "ACTIVE",
                      "DRAINING",
                      "RECONCILIATION_REQUIRED"
                    ]
                  }
                },
                "required": [
                  "owner",
                  "epoch",
                  "state"
                ],
                "additionalProperties": true
              },
              "candidates": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "properties": {
                    "movementId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "priority": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 900,
                      "multipleOf": 100
                    },
                    "eligibleAt": {
                      "type": "string",
                      "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
                      "format": "date-time"
                    },
                    "zoneId": {
                      "enum": [
                        "ambient",
                        "chilled"
                      ]
                    },
                    "owner": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "epoch": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "allocationState": {
                      "enum": [
                        "ASSIGNED",
                        "PENDING",
                        "COMPLETED",
                        "CANCELLED"
                      ]
                    },
                    "commandState": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "movementId",
                    "priority",
                    "eligibleAt",
                    "zoneId",
                    "owner",
                    "epoch",
                    "allocationState",
                    "commandState"
                  ],
                  "additionalProperties": true
                }
              },
              "lanes": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "properties": {
                    "siteId": {
                      "type": "string"
                    },
                    "zoneId": {
                      "enum": [
                        "ambient",
                        "chilled"
                      ]
                    },
                    "laneId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,39}$"
                    },
                    "blocked": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "siteId",
                    "zoneId",
                    "laneId",
                    "blocked"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "ruleVersion",
              "siteId",
              "zoneId",
              "decisionAt",
              "observedAt",
              "topologyVersion",
              "worldMismatch",
              "route",
              "candidates",
              "lanes"
            ],
            "additionalProperties": true
          },
          "legacyProposal": {
            "type": "object",
            "properties": {
              "ruleVersion": {
                "const": 1
              },
              "selectedMovementId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "selectedLaneId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ranking": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "properties": {
                    "movementId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "reason": {
                      "enum": [
                        "READY",
                        "WORLD_MISMATCH",
                        "OBSERVATION_STALE",
                        "ROUTE_UNCERTAIN",
                        "ZONE_MISMATCH",
                        "OWNER_MISMATCH",
                        "UNASSIGNED",
                        "COMMAND_RECORDED",
                        "NOT_ELIGIBLE",
                        "LANE_BLOCKED"
                      ]
                    },
                    "laneId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "movementId",
                    "reason",
                    "laneId"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "ruleVersion",
              "selectedMovementId",
              "selectedLaneId",
              "ranking"
            ],
            "additionalProperties": true
          },
          "executionProposal": {
            "type": "object",
            "properties": {
              "ruleVersion": {
                "const": 1
              },
              "selectedMovementId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "selectedLaneId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ranking": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "properties": {
                    "movementId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "reason": {
                      "enum": [
                        "READY",
                        "WORLD_MISMATCH",
                        "OBSERVATION_STALE",
                        "ROUTE_UNCERTAIN",
                        "ZONE_MISMATCH",
                        "OWNER_MISMATCH",
                        "UNASSIGNED",
                        "COMMAND_RECORDED",
                        "NOT_ELIGIBLE",
                        "LANE_BLOCKED"
                      ]
                    },
                    "laneId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "movementId",
                    "reason",
                    "laneId"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "ruleVersion",
              "selectedMovementId",
              "selectedLaneId",
              "ranking"
            ],
            "additionalProperties": true
          },
          "matches": {
            "type": "boolean"
          },
          "comparedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "roundId",
          "inputHash",
          "input",
          "legacyProposal",
          "executionProposal",
          "matches",
          "comparedAt"
        ],
        "additionalProperties": true
      },
      "zone-route-list": {
        "$ref": "../schemas/zone-route-list.v1.json"
      },
      "migration-view": {
        "$ref": "../schemas/migration-view.v1.json"
      },
      "migration-list": {
        "$ref": "../schemas/migration-list.v1.json"
      },
      "execution-task-list": {
        "$ref": "../schemas/execution-task-list.v1.json"
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "problem": {
        "description": "Bounded problem response without internal exceptions",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/problem"
            }
          }
        }
      }
    }
  }
