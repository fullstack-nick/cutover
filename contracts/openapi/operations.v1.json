{
  "openapi": "3.1.2",
  "info": {
    "title": "Cutover operations API",
    "version": "1.0.0",
    "description": "Local synthetic operations. Every request checks role and site. Errors use RFC 9457: 400 malformed, 401 unauthenticated, 403 role denied, 404 outside site or absent, 409 conflict, 413 body over 64 KiB, 422 domain validation, 429 rate limit, 503 durable admission unavailable with Retry-After."
  },
  "servers": [
    {
      "url": "http://localhost:8780"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/api/v1/sites/{siteId}/orders": {
      "parameters": [
        {
          "name": "siteId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 40
          }
        }
      ],
      "post": {
        "operationId": "createOrders",
        "summary": "Durably accept synthetic work; acceptance is not completion",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/order-request"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Committed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/accepted"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      },
      "get": {
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current owner projection, with observation time where applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/order-page"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/api/v1/sites/{siteId}/orders/{id}": {
      "parameters": [
        {
          "name": "siteId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 40
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getOrders",
        "responses": {
          "200": {
            "description": "Current owner projection, with observation time where applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/order-view"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/api/v1/sites/{siteId}/return-receipts": {
      "parameters": [
        {
          "name": "siteId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 40
          }
        }
      ],
      "post": {
        "operationId": "createReturnReceipts",
        "summary": "Durably accept synthetic work; acceptance is not completion",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/receipt-request"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Committed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/accepted"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      },
      "get": {
        "operationId": "listReturnReceipts",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page with items, nextCursor and observedAt"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/api/v1/sites/{siteId}/return-receipts/{id}": {
      "parameters": [
        {
          "name": "siteId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 40
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getReturnReceipts",
        "responses": {
          "200": {
            "description": "Resource projection and observation time"
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/api/v1/sites/{siteId}/tasks": {
      "parameters": [
        {
          "name": "siteId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "listTasks",
        "responses": {
          "200": {
            "description": "Current owner projection, with observation time where applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/task-list"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/api/v1/sites/{siteId}/equipment": {
      "parameters": [
        {
          "name": "siteId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getEquipment",
        "responses": {
          "200": {
            "description": "Current owner projection, with observation time where applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/equipment-view"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/api/v1/sites/{siteId}/commands/{id}": {
      "parameters": [
        {
          "name": "siteId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getCommand",
        "responses": {
          "200": {
            "description": "Current owner projection, with observation time where applicable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/command-view"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/api/v1/sites/{siteId}/commands": {
      "parameters": [
        {
          "name": "siteId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 40
          }
        }
      ],
      "get": {
        "operationId": "listRecoveryCommands",
        "summary": "Read up to 100 site-scoped uncertain or quarantined commands, oldest first",
        "responses": {
          "200": {
            "description": "Observed recovery queue"
          },
          "400": {
            "$ref": "#/components/responses/problem"
          },
          "401": {
            "$ref": "#/components/responses/problem"
          },
          "403": {
            "$ref": "#/components/responses/problem"
          },
          "404": {
            "$ref": "#/components/responses/problem"
          },
          "409": {
            "$ref": "#/components/responses/problem"
          },
          "413": {
            "$ref": "#/components/responses/problem"
          },
          "422": {
            "$ref": "#/components/responses/problem"
          },
          "503": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    },
    "/api/v1/sites/{siteId}/commands/{id}/reconciliation": {
      "parameters": [
        {
          "name": "siteId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 40
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "investigateCommand",
        "summary": "Supervisor records a versioned status investigation using the original command ID",
        "description": "Requires the supervisor role and a reason. A successful response records a request; it is not physical retry authority or proof of completion. A live lease, terminal state or changed version returns 409.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/reconciliation-request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Investigation request recorded; repeats with the same key return the same response"
          },
          "400": {
            "$ref": "#/components/responses/problem"
          },
          "401": {
            "$ref": "#/components/responses/problem"
          },
          "403": {
            "$ref": "#/components/responses/problem"
          },
          "404": {
            "$ref": "#/components/responses/problem"
          },
          "409": {
            "$ref": "#/components/responses/problem"
          },
          "413": {
            "$ref": "#/components/responses/problem"
          },
          "422": {
            "$ref": "#/components/responses/problem"
          },
          "503": {
            "$ref": "#/components/responses/problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "equipment-command": {
        "$ref": "../schemas/equipment-command.v1.json"
      },
      "event-envelope": {
        "$ref": "../schemas/event-envelope.v1.json"
      },
      "migration-request": {
        "$ref": "../schemas/migration-request.v1.json"
      },
      "movement": {
        "$ref": "../schemas/movement.v1.json"
      },
      "order-request": {
        "$ref": "../schemas/order-request.v1.json"
      },
      "receipt-request": {
        "$ref": "../schemas/receipt-request.v1.json"
      },
      "reconciliation-request": {
        "$ref": "../schemas/reconciliation-request.v1.json"
      },
      "problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "accepted": {
        "type": "object",
        "required": [
          "id",
          "statusUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "statusUrl": {
            "type": "string"
          }
        }
      },
      "order-view": {
        "$ref": "../schemas/order-view.v1.json"
      },
      "order-page": {
        "$ref": "../schemas/order-page.v1.json"
      },
      "task-list": {
        "$ref": "../schemas/task-list.v1.json"
      },
      "equipment-view": {
        "$ref": "../schemas/equipment-view.v1.json"
      },
      "command-view": {
        "$ref": "../schemas/command-view.v1.json"
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "problem": {
        "description": "Bounded problem response without internal exceptions",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/problem"
            }
          }
        }
      }
    }
  }
}
