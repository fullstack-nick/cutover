{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cutover:event-envelope:v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "siteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "aggregateType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "traceparent": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "siteId",
    "source",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "correlationId",
    "causationId",
    "traceparent",
    "payload"
  ],
  "additionalProperties": true
}
