{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cutover:movement:v1",
  "type": "object",
  "properties": {
    "movementId": {
      "type": "string",
      "format": "uuid"
    },
    "reservationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "siteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "product": {
      "enum": [
        "fulfilment",
        "returns"
      ]
    },
    "zoneId": {
      "type": "string",
      "enum": [
        "ambient",
        "chilled",
        "returns"
      ]
    },
    "loadId": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "destination": {
      "enum": [
        "outbound-staging",
        "reusable",
        "cleaning",
        "damaged"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "eligibleAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "movementId",
    "reservationId",
    "siteId",
    "product",
    "zoneId",
    "loadId",
    "source",
    "destination",
    "quantity",
    "priority",
    "eligibleAt"
  ],
  "additionalProperties": true
}
