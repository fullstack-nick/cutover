{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cutover:equipment-command:v1",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid"
    },
    "allocationId": {
      "type": "string",
      "format": "uuid"
    },
    "movementId": {
      "type": "string",
      "format": "uuid"
    },
    "siteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "loadId": {
      "type": "string",
      "format": "uuid"
    },
    "worldId": {
      "type": "string",
      "format": "uuid"
    },
    "journalGeneration": {
      "type": "string",
      "format": "uuid"
    },
    "expectedLoadVersion": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "destination": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "zoneId": {
      "type": "string",
      "enum": [
        "ambient",
        "chilled",
        "returns"
      ]
    },
    "laneId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "required": [
    "commandId",
    "allocationId",
    "movementId",
    "siteId",
    "loadId",
    "worldId",
    "journalGeneration",
    "expectedLoadVersion",
    "source",
    "destination",
    "zoneId",
    "laneId",
    "quantity"
  ],
  "additionalProperties": false
}
