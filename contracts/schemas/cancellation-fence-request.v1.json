{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["cancellationId", "orderId", "siteId", "actor", "reason", "movements"],
  "properties": {
    "cancellationId": {"type": "string", "format": "uuid"},
    "orderId": {"type": "string", "format": "uuid"},
    "siteId": {"type": "string", "maxLength": 40},
    "actor": {"type": "string", "minLength": 1, "maxLength": 200},
    "reason": {"type": "string", "minLength": 8, "maxLength": 500},
    "movements": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "object"}, "description": "Every item is additionally validated against movement.v1 by the adapter."}
  },
  "additionalProperties": false
}
