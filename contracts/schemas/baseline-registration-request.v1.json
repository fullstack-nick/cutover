{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "registrationId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedControlVersion": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "siteId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "movementId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "allocationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "epoch": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "movement": {
            "$id": "urn:cutover:movement:v1",
            "type": "object",
            "properties": {
              "movementId": {
                "type": "string",
                "format": "uuid"
              },
              "reservationId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "siteId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "product": {
                "enum": [
                  "fulfilment",
                  "returns"
                ]
              },
              "zoneId": {
                "type": "string",
                "enum": [
                  "ambient",
                  "chilled",
                  "returns"
                ]
              },
              "loadId": {
                "type": "string",
                "format": "uuid"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "destination": {
                "enum": [
                  "outbound-staging",
                  "reusable",
                  "cleaning",
                  "damaged"
                ]
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "eligibleAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "movementId",
              "reservationId",
              "siteId",
              "product",
              "zoneId",
              "loadId",
              "source",
              "destination",
              "quantity",
              "priority",
              "eligibleAt"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "taskId",
          "siteId",
          "movementId",
          "state",
          "allocationId",
          "epoch",
          "movement"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "registrationId",
    "expectedControlVersion",
    "items"
  ],
  "additionalProperties": true
}
