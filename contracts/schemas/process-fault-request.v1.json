{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["reason", "expectedVersion", "checkpoint"],
  "properties": {
    "reason": {"type": "string", "minLength": 8, "maxLength": 500},
    "expectedVersion": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "checkpoint": {"enum": ["AFTER_BUSINESS_COMMIT", "AFTER_BROKER_CONFIRM", "AFTER_EFFECT_BEFORE_ACK"]},
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,79}\\.v[1-9][0-9]?$"}
  },
  "additionalProperties": false
}
