{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cancellationId": {
      "type": "string",
      "format": "uuid"
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "siteId": {
      "type": "string"
    },
    "state": {
      "const": "FENCED"
    },
    "worldId": {
      "type": "string",
      "format": "uuid"
    },
    "journalGeneration": {
      "type": "string",
      "format": "uuid"
    },
    "proofHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "movements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "movementId": {
            "type": "string",
            "format": "uuid"
          },
          "allocationId": {
            "type": "string",
            "format": "uuid"
          },
          "allocationVersion": {
            "type": "integer",
            "minimum": 1
          },
          "proof": {
            "const": "NEVER_SUBMITTED"
          }
        },
        "required": [
          "movementId",
          "allocationId",
          "allocationVersion",
          "proof"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "cancellationId",
    "orderId",
    "siteId",
    "state",
    "worldId",
    "journalGeneration",
    "proofHash",
    "issuedAt",
    "movements"
  ],
  "additionalProperties": true
}
