{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Cutover durable events",
    "version": "1.0.0",
    "description": "Complete, versioned aggregate streams include observations that a consumer does not apply as business effects. Outbound order streams include OrderAccepted.v1, StockReservationRecorded.v1, OrderProgressed.v1, OrderCancellationRequested.v1, OrderCancellationDenied.v1 and OrderCancelled.v1. Adapter movement streams include MovementAssigned.v1, command progress and MovementCancelled.v1. A cancellation event is not physical completion evidence; only the inventory owner releases reservations after the complete fence certificate."
  },
  "defaultContentType": "application/json",
  "channels": {
    "business": {
      "address": "cutover.{publisher}.v1",
      "parameters": {
        "publisher": {
          "description": "Authenticated publisher identity"
        }
      },
      "messages": {
        "event": {
          "$ref": "#/components/messages/event"
        }
      }
    },
    "observation": {
      "address": "cutover.observation.v1",
      "description": "Dedicated bounded observation exchange. Only legacy-core publishes; the shadow identity consumes. It is independent of every business outbox quota.",
      "messages": {
        "snapshot": {
          "$ref": "#/components/messages/schedulingObservation"
        }
      }
    }
  },
  "operations": {
    "publishEvent": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/business"
      }
    },
    "publishSchedulingObservation": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/observation"
      }
    }
  },
  "components": {
    "messages": {
      "event": {
        "name": "VersionedBusinessEvent",
        "payload": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "eventType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "schemaVersion": {
              "const": 1
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "siteId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "aggregateType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "aggregateId": {
              "type": "string",
              "format": "uuid"
            },
            "aggregateVersion": {
              "type": "integer",
              "minimum": 1
            },
            "correlationId": {
              "type": "string",
              "format": "uuid"
            },
            "causationId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "traceparent": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "payload": {
              "type": "object"
            }
          },
          "required": [
            "eventId",
            "eventType",
            "schemaVersion",
            "occurredAt",
            "siteId",
            "source",
            "aggregateType",
            "aggregateId",
            "aggregateVersion",
            "correlationId",
            "causationId",
            "traceparent",
            "payload"
          ],
          "additionalProperties": true
        }
      },
      "schedulingObservation": {
        "name": "SchedulingSnapshotRecordedV1",
        "payload": {
          "$id": "urn:cutover:event-envelope:v1",
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "eventType": {
              "const": "SchedulingSnapshotRecorded.v1"
            },
            "schemaVersion": {
              "const": 1
            },
            "occurredAt": {
              "type": "string",
              "format": "date-time"
            },
            "siteId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "source": {
              "const": "legacy-core"
            },
            "aggregateType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "aggregateId": {
              "type": "string",
              "format": "uuid"
            },
            "aggregateVersion": {
              "type": "integer",
              "minimum": 1
            },
            "correlationId": {
              "type": "string",
              "format": "uuid"
            },
            "causationId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "traceparent": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "payload": {
              "type": "object",
              "properties": {
                "roundId": {
                  "type": "string",
                  "format": "uuid"
                },
                "siteId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,39}$"
                },
                "inputHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "origin": {
                  "enum": [
                    "LIVE",
                    "SEEDED_TEST"
                  ]
                },
                "input": {
                  "type": "object",
                  "properties": {
                    "ruleVersion": {
                      "const": 1
                    },
                    "siteId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,39}$"
                    },
                    "zoneId": {
                      "enum": [
                        "ambient",
                        "chilled"
                      ]
                    },
                    "decisionAt": {
                      "type": "string",
                      "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
                      "format": "date-time"
                    },
                    "observedAt": {
                      "type": "string",
                      "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
                      "format": "date-time"
                    },
                    "topologyVersion": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "worldMismatch": {
                      "type": "boolean"
                    },
                    "route": {
                      "type": "object",
                      "properties": {
                        "owner": {
                          "enum": [
                            "legacy-core",
                            "execution-service"
                          ]
                        },
                        "epoch": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "state": {
                          "enum": [
                            "ACTIVE",
                            "DRAINING",
                            "RECONCILIATION_REQUIRED"
                          ]
                        }
                      },
                      "required": [
                        "owner",
                        "epoch",
                        "state"
                      ],
                      "additionalProperties": true
                    },
                    "candidates": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "properties": {
                          "movementId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "priority": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 900,
                            "multipleOf": 100
                          },
                          "eligibleAt": {
                            "type": "string",
                            "pattern": "T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$",
                            "format": "date-time"
                          },
                          "zoneId": {
                            "enum": [
                              "ambient",
                              "chilled"
                            ]
                          },
                          "owner": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "epoch": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "allocationState": {
                            "enum": [
                              "ASSIGNED",
                              "PENDING",
                              "COMPLETED",
                              "CANCELLED"
                            ]
                          },
                          "commandState": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "movementId",
                          "priority",
                          "eligibleAt",
                          "zoneId",
                          "owner",
                          "epoch",
                          "allocationState",
                          "commandState"
                        ],
                        "additionalProperties": true
                      }
                    },
                    "lanes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "object",
                        "properties": {
                          "siteId": {
                            "type": "string"
                          },
                          "zoneId": {
                            "enum": [
                              "ambient",
                              "chilled"
                            ]
                          },
                          "laneId": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,39}$"
                          },
                          "blocked": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "siteId",
                          "zoneId",
                          "laneId",
                          "blocked"
                        ],
                        "additionalProperties": true
                      }
                    }
                  },
                  "required": [
                    "ruleVersion",
                    "siteId",
                    "zoneId",
                    "decisionAt",
                    "observedAt",
                    "topologyVersion",
                    "worldMismatch",
                    "route",
                    "candidates",
                    "lanes"
                  ],
                  "additionalProperties": true
                },
                "legacyProposal": {
                  "type": "object",
                  "properties": {
                    "ruleVersion": {
                      "const": 1
                    },
                    "selectedMovementId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid"
                    },
                    "selectedLaneId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ranking": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "properties": {
                          "movementId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "reason": {
                            "enum": [
                              "READY",
                              "WORLD_MISMATCH",
                              "OBSERVATION_STALE",
                              "ROUTE_UNCERTAIN",
                              "ZONE_MISMATCH",
                              "OWNER_MISMATCH",
                              "UNASSIGNED",
                              "COMMAND_RECORDED",
                              "NOT_ELIGIBLE",
                              "LANE_BLOCKED"
                            ]
                          },
                          "laneId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "movementId",
                          "reason",
                          "laneId"
                        ],
                        "additionalProperties": true
                      }
                    }
                  },
                  "required": [
                    "ruleVersion",
                    "selectedMovementId",
                    "selectedLaneId",
                    "ranking"
                  ],
                  "additionalProperties": true
                }
              },
              "required": [
                "roundId",
                "siteId",
                "inputHash",
                "origin",
                "input",
                "legacyProposal"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "eventId",
            "eventType",
            "schemaVersion",
            "occurredAt",
            "siteId",
            "source",
            "aggregateType",
            "aggregateId",
            "aggregateVersion",
            "correlationId",
            "causationId",
            "traceparent",
            "payload"
          ],
          "additionalProperties": true
        }
      }
    }
  }
}
