<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.1</version><relativePath/>
  </parent>
  <groupId>dev.cutover</groupId><artifactId>cutover-parent</artifactId><version>0.1.0-SNAPSHOT</version><packaging>pom</packaging>
  <name>Cutover</name><description>A local grocery fulfilment modernization lab</description>
  <licenses><license><name>MIT License</name><url>https://opensource.org/license/mit</url></license></licenses>
  <properties>
    <java.version>21</java.version>
    <project.build.outputTimestamp>2026-09-07T16:00:00Z</project.build.outputTimestamp>
    <networknt.version>3.0.7</networknt.version>
    <postgres.image>postgres:18.6-bookworm</postgres.image>
    <rabbitmq.image>rabbitmq:4.3.5-management</rabbitmq.image>
  </properties>
  <modules>
    <module>platform/service-starter</module>
    <module>platform/test-support</module>
    <module>tools/compatibility-checks</module>
    <module>apps/equipment-simulator</module>
    <module>apps/equipment-adapter</module>
    <module>apps/legacy-core</module>
  </modules>
  <dependencyManagement><dependencies>
    <dependency><groupId>dev.cutover</groupId><artifactId>service-starter</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId><version>${networknt.version}</version></dependency>
  </dependencies></dependencyManagement>
  <build><pluginManagement><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><configuration><layers><enabled>true</enabled></layers></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><argLine>-Xmx640m</argLine><forkCount>1</forkCount><reuseForks>true</reuseForks><systemPropertyVariables><cutover.postgres.image>${postgres.image}</cutover.postgres.image><cutover.rabbitmq.image>${rabbitmq.image}</cutover.rabbitmq.image><org.jooq.no-logo>true</org.jooq.no-logo><org.jooq.no-tips>true</org.jooq.no-tips></systemPropertyVariables></configuration></plugin>
    <plugin><groupId>org.jooq</groupId><artifactId>jooq-codegen-maven</artifactId><version>${jooq.version}</version></plugin>
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.3</version></plugin>
  </plugins></pluginManagement></build>
</project>
